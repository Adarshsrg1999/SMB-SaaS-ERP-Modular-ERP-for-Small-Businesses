# Server Configuration
PORT=5000

# JWT Secret Key for authentication
SECRET_KEY=supersecretkey

# Telegram Bot Configuration
# Get your bot token from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Telegram Chat ID to receive notifications
# Get your chat ID by messaging @userinfobot on Telegram
TELEGRAM_CHAT_ID=your_chat_id_here

# Notification Settings
# Enable or disable all notifications (true/false)
ENABLE_NOTIFICATIONS=true

# Notification Thresholds
# Large order threshold in rupees (notifications sent for orders above this amount)
LARGE_ORDER_THRESHOLD=100000

# Large stock adjustment threshold in units (notifications sent for adjustments above this amount)
LARGE_STOCK_ADJUSTMENT_THRESHOLD=50
